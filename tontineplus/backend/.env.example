# Copiez ce fichier en .env et remplissez-le. Ne versionnez jamais .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=tontineplus
DB_USER=postgres
DB_PASSWORD=votre-mot-de-passe-postgres
DB_HOST=localhost
DB_PORT=5432

MOBILE_MONEY_WEBHOOK_SECRET=secret-partage-avec-le-fournisseur

# Mobile Money : "simulation" (aucun appel réseau) ou "reel" (MTN MoMo)
MOBILE_MONEY_MODE=simulation
# Identifiants du portail https://momodeveloper.mtn.com (produit Collection)
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_ENVIRONNEMENT=sandbox
MTN_MOMO_DEVISE=EUR
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
# Adresse publique de votre API, pour les notifications MTN (facultatif)
MTN_MOMO_CALLBACK_URL=

# SMS : "console" (le code s'affiche dans le terminal du serveur) ou "africastalking"
SMS_BACKEND=console
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_EXPEDITEUR=
