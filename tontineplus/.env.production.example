# Copiez ce fichier en .env (à côté de docker-compose.yml) et remplissez-le. Ne le versionnez jamais.

# Nom de domaine pointant vers le serveur (enregistrement DNS A). Caddy obtient le certificat HTTPS.
DOMAINE=tontine.exemple.cm

DJANGO_DEBUG=false
# Générez-la : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=tontine.exemple.cm
GUNICORN_WORKERS=3

DB_NAME=tontineplus
DB_USER=tontineplus
# Mot de passe long et aléatoire, propre à ce serveur.
DB_PASSWORD=

MOBILE_MONEY_WEBHOOK_SECRET=
MOBILE_MONEY_MODE=simulation
MTN_MOMO_BASE_URL=https://proxy.momoapi.mtn.com
MTN_MOMO_ENVIRONNEMENT=mtncameroon
MTN_MOMO_DEVISE=XAF
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_CALLBACK_URL=https://tontine.exemple.cm/api/v1/webhooks/mtn-momo/

SMS_BACKEND=africastalking
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_EXPEDITEUR=
