# TONTINE+ en production. DOMAINE vient de docker-compose ; Caddy obtient le certificat HTTPS tout seul.
{$DOMAINE:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /admin* {
		reverse_proxy backend:8000
	}
	# Fichiers statiques de l'admin Django (collectstatic, volume partagé).
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	# Appli React : toute autre adresse renvoie index.html (routes côté navigateur).
	handle {
		root * /srv/app
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
